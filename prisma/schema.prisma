generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id      String     @id @default(cuid())
  email   String     @unique
  name    String
  hash    String
  role    String
  profile Employee?
  team    Employee[] @relation("manager")
  owned   Task[]
  events  Audit[]
}

model Employee {
  id        String    @id @default(cuid())
  userId    String    @unique
  user      User      @relation(fields: [userId], references: [id])
  managerId String
  manager   User      @relation("manager", fields: [managerId], references: [id])
  job       String
  location  String
  startDate DateTime
  version   Int       @default(1)
  tasks     Task[]
  events    Audit[]
  handoffs  Handoff[]
}

model Template {
  id            String       @id
  title         String
  description   String
  category      String
  ownerRole     String
  required      Boolean
  job           String?
  location      String?
  position      Int
  tasks         Task[]
  prerequisites Dependency[] @relation("child")
  unlocks       Dependency[] @relation("parent")
}

model Dependency {
  childId  String
  parentId String
  child    Template @relation("child", fields: [childId], references: [id])
  parent   Template @relation("parent", fields: [parentId], references: [id])

  @@id([childId, parentId])
}

model Task {
  id          String    @id @default(cuid())
  employeeId  String
  employee    Employee  @relation(fields: [employeeId], references: [id])
  templateId  String
  template    Template  @relation(fields: [templateId], references: [id])
  ownerId     String
  owner       User      @relation(fields: [ownerId], references: [id])
  completedAt DateTime?
  active      Boolean   @default(true)
  approval    Approval?

  @@unique([employeeId, templateId])
}

model Approval {
  id        String    @id @default(cuid())
  taskId    String    @unique
  task      Task      @relation(fields: [taskId], references: [id])
  decision  String?
  decidedAt DateTime?
}

model Policy {
  id       String  @id
  title    String
  body     String
  job      String?
  location String?
  approved Boolean
  version  Int
}

model Handoff {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  question   String
  answer     String?
  answeredBy String?
  answeredAt DateTime?
  createdAt  DateTime @default(now())
}

model Audit {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  actorId    String
  actor      User     @relation(fields: [actorId], references: [id])
  message    String
  createdAt  DateTime @default(now())

  @@index([employeeId, createdAt])
}

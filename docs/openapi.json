            "type": "string"
          },
          "employeeId": {
            "type": "string"
          },
          "question": {
            "type": "string"
          },
          "createdAt": {
            "type": "string"
          },
          "answer": {
            "type": [
              "string",
              "null"
            ]
          },
          "answeredAt": {
            "type": [
              "string",
              "null"
            ]
          },
          "answeredBy": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "employeeId",
          "question",
          "createdAt",
          "answer",
          "answeredAt",
          "answeredBy"
        ],
        "additionalProperties": false
